# CreditOS environment variables — copy to .env and fill in real values.
# DO NOT commit .env to version control. This file (.env.example) is safe to commit.

# PostgreSQL credentials (used by the db service and interpolated into DATABASE_URL)
POSTGRES_USER=creditos
POSTGRES_PASSWORD=change-me-in-production
POSTGRES_DB=creditos

# Backend JWT secret key — generate a strong random value for production.
# Example: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=change-me-in-production-use-secrets-token-hex-32

# Comma-separated list of allowed CORS origins for the backend
CORS_ORIGINS=http://localhost:3000

# Optional: override demo seed credentials (defaults shown)
# SEED_ADMIN_EMAIL=admin@creditos.app
# SEED_ADMIN_PASSWORD=credits123
# SEED_USER_EMAIL=buyer@acme.io
# SEED_USER_PASSWORD=credits123
